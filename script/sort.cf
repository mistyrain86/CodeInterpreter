// sort.cf — 버블 정렬 예제
// 실행: CodeInterpreter.exe run script/sort.cf

print "=== 버블 정렬 ===";

var arr = Array(6);
arr[0] = 64;
arr[1] = 34;
arr[2] = 25;
arr[3] = 12;
arr[4] = 78;
arr[5] = 42;

func bubbleSort(arr, n) {
    for (var i = 0; i < n - 1; i = i + 1) {
        for (var j = 0; j < n - i - 1; j = j + 1) {
            if (arr[j] > arr[j + 1]) {
                var temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

func printArray(arr, n) {
    for (var i = 0; i < n; i = i + 1) {
        print arr[i];
    }
}

print "정렬 전:";
printArray(arr, 6);

bubbleSort(arr, 6);

print "정렬 후:";
printArray(arr, 6);

print "최솟값:";
print arr[0];
print "최댓값:";
print arr[5];
