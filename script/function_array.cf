// function_array.cf — 함수 + 배열 종합 예제
// 실행: CodeInterpreter.exe run script/function_array.cf

print "=== 함수와 배열 예제 ===";

func add(a, b) {
    return a + b;
}

func multiply(a, b) {
    return a * b;
}

print "3 + 7 =";
print add(3, 7);
print "4 * 5 =";
print multiply(4, 5);

func factorial(n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}

print "5! =";
print factorial(5);
print "10! =";
print factorial(10);

var arr = Array(5);
for (var i = 0; i < 5; i = i + 1) {
    arr[i] = (i + 1) * 10;
}

print "배열 값:";
for (var i = 0; i < 5; i = i + 1) {
    print arr[i];
}

func sumArray(arr, size) {
    var total = 0;
    for (var i = 0; i < size; i = i + 1) {
        total = total + arr[i];
    }
    return total;
}

print "배열 합계:";
print sumArray(arr, 5);
